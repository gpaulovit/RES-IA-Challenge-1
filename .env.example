# Configurações do Bot do Telegram (RES-IA Challenge 1)
# NUNCA comite o arquivo .env preenchido no repositório!

# Token gerado pelo @BotFather no Telegram
TELEGRAM_BOT_TOKEN=seu_token_aqui

# Caminho para os logs e registros anônimos de consultas (LGPD)
CHECK_LOGS_PATH=data/registros/consultas.jsonl

# Modo de execução do bot (polling ou webhook)
BOT_MODE=polling

# Chave da Google Fact Check Tools API (scripts/atualizar_checagens_factcheck.py)
FACTCHECK_API_KEY=sua_chave_aqui

# Azure & MLOps (DVC, MLflow e Observabilidade)
# Connection String do Azure Storage para o remote do DVC (azure://dvc/res-ia-challenge-1)
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net

# MLflow Tracking URI nativo do Azure ML Workspace (vazio = treino roda offline)
MLFLOW_TRACKING_URI=azureml://eastus.api.azureml.ms/mlflow/v1.0/subscriptions/.../resourceGroups/.../providers/Microsoft.MachineLearningServices/workspaces/...

# Observabilidade em produção no Azure Container Apps (latência, volume e erros)
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=...;IngestionEndpoint=https://...